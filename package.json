{
  "name": "wyn-backend",
  "version": "1.0.0",
  "main": "src/index.ts",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "db:reset": "npx prisma db push --force-reset",
    "db:seed": "npx prisma db seed",
    "setup:windows": "scripts\\windows-setup.bat",
    "dev:windows": "scripts\\windows-dev.bat",
    "mobile:windows": "scripts\\windows-mobile.bat",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:reset": "docker-compose down -v && docker-compose up -d",
    "frontend:dev": "cd frontend && npm run dev",
    "frontend:build": "cd frontend && npm run build",
    "frontend:ios": "cd frontend && npx cap run ios",
    "frontend:android": "cd frontend && npx cap run android",
    "dev:all": "npm run docker:up && npm run frontend:dev",
    "prisma:migrate": "docker exec -it gabriel-api npx prisma migrate dev",
    "prisma:seed": "docker exec -it gabriel-api npx prisma db seed",
    "prisma:studio": "docker exec -it gabriel-api npx prisma studio",
    "setup": "npm install && cd frontend && npm install && cd .. && npm run docker:up && sleep 5 && npm run prisma:migrate && npm run prisma:seed",
    "clean": "rm -rf node_modules frontend/node_modules frontend/ios frontend/android && docker-compose down -v"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "@types/cookie-parser": "^1.4.9",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "tailwindcss": "^3.4.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cors": "^2.8.18",
    "@types/express": "^4.17.23",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.15.30",
    "nodemon": "^3.1.10",
    "prisma": "^6.8.2",
    "ts-node": "^10.9.1",
    "typescript": "^5.8.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
